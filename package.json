{
  "name": "@x3/ecfr-toolkit",
  "version": "1.0.0",
  "description": "Read the Code of Federal Regulations from the official eCFR API as clean paragraph-level data: citations, full text, search, change history and diffs.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"test/*.test.ts\"",
    "prepare": "npm run build"
  },
  "keywords": [
    "ecfr",
    "cfr",
    "code-of-federal-regulations",
    "regulations",
    "compliance",
    "osha",
    "fmcsa",
    "phmsa",
    "uscg",
    "federal-register"
  ],
  "author": "X3 All-American (https://github.com/x3allamerican)",
  "license": "MIT",
  "homepage": "https://github.com/x3allamerican/x3-ecfr-toolkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x3allamerican/x3-ecfr-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/x3allamerican/x3-ecfr-toolkit/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "bin": {
    "ecfr": "bin/ecfr.js"
  }
}
